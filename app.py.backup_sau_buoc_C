def _build_kv_combo_chart(
    kv_charts: list[dict],
    sum_key: str,
    avg_key: str,
    title: str,
    bar_color: str,
    line_color: str,
    per_kv_color: bool = False,
    bar_label: str = "Tổng SL",
    line_label: str = "Bình quân/ĐVKD",
):
    """
    Combo Chart (Cột dọc + Đường) DÙNG CHUNG cho Bảng D/E/F VÀ Khối G/H mới: Cột = giá trị theo
    `sum_key` (trục trái), Đường = giá trị theo `avg_key` (trục phải) — generic theo bất kỳ cặp
    2 chỉ số nào trong kv_charts, không riêng gì "tổng/bình quân" (dùng `bar_label`/`line_label`
    để đổi nhãn legend/trục cho đúng ngữ nghĩa khi tái sử dụng cho cặp chỉ số khác).
    """
    labels = [k["kv_label"] for k in kv_charts]
    sums = [k[sum_key] for k in kv_charts]
    avgs = [k[avg_key] for k in kv_charts]
    bar_colors = [get_kv_color(lbl, i) for i, lbl in enumerate(labels)] if per_kv_color else bar_color

    fig = go.Figure()
    fig.add_trace(
        go.Bar(
            x=labels,
            y=sums,
            name=bar_label,
            marker=dict(color=bar_colors),
            text=[f"{v:,.0f}".replace(",", ".") for v in sums],
            textposition="outside",
            textfont=dict(size=10.5, color="#111827", family="Segoe UI, Arial"),
            yaxis="y1",
        )
    )
    fig.add_trace(
        go.Scatter(
            x=labels,
            y=avgs,
            name=line_label,
            mode="lines+markers+text",
            line=dict(color=line_color, width=2.5),
            marker=dict(color=line_color, size=8),
            text=[f"{v:,.1f}".replace(",", ".") for v in avgs],
            textposition="top center",
            textfont=dict(size=10, color=line_color, family="Segoe UI, Arial"),
            yaxis="y2",
        )
    )

    fig.update_layout(
        title=dict(
            text=f"<b>{title}</b>",
            x=0.5,
            y=0.98,
            xanchor="center",
            yanchor="top",
            font=dict(size=12.5, color="#111827", family="Segoe UI, Arial"),
        ),
        xaxis=dict(tickfont=dict(size=10, color="#374151"), tickangle=-12),
        yaxis=dict(title=dict(text=bar_label, font=dict(size=10.5)), gridcolor="#f0f2f5", tickfont=dict(size=10, color="#6b7280")),
        yaxis2=dict(
            title=dict(text=line_label, font=dict(size=10.5)),
            overlaying="y",
            side="right",
            showgrid=False,
            tickfont=dict(size=10, color="#6b7280"),
        ),
        legend=dict(orientation="h", yanchor="bottom", y=1.005, xanchor="right", x=1, font=dict(size=10)),
        margin=dict(l=10, r=10, t=55, b=45),
        height=300,
        plot_bgcolor="white",
        paper_bgcolor="white",
        barmode="group",
    )
    return fig


